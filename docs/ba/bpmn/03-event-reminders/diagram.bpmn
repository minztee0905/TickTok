<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_bpmn-03-event-reminders" targetNamespace="https://ticktok.local/analysis/bpmn-03-event-reminders" exporter="TickTok BA diagrams" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_bpmn-03-event-reminders">
    <bpmn:participant id="Participant_bpmn-03-event-reminders" name="BPMN-03 · Lưu sự kiện và lập hai mốc nhắc" processRef="Process_bpmn-03-event-reminders" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn-03-event-reminders" name="BPMN-03 · Lưu sự kiện và lập hai mốc nhắc" isExecutable="false">
    <bpmn:documentation>Quy trình nghiệp vụ TickTok. Mô hình phân tích, không thực thi; thao tác SDK và callback được biểu diễn bằng service task.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_bpmn-03-event-reminders">
      <bpmn:lane id="Lane_bpmn-03-event-reminders_0" name="Tương tác người dùng / UI">
        <bpmn:flowNodeRef>E_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_hint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_authfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_badend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn-03-event-reminders_1" name="Ứng dụng TickTok">
        <bpmn:flowNodeRef>E_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_errorend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_detached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn-03-event-reminders_2" name="Firestore SDK / callback">
        <bpmn:flowNodeRef>E_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_timestamp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_attached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_skip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_more</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn-03-event-reminders_3" name="Android: quyền và alarm">
        <bpmn:flowNodeRef>E_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_manager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_times</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_future</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_schedule</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E_start" name="Thêm hoặc sửa sự kiện">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="E_input" name="Nhập tên, biểu tượng, chọn ngày; bấm Lưu">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E_valid" name="Có ngày và tên sau trim?" default="Flow_3" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="E_hint" name="Chưa ngày: Lưu tắt; thiếu tên: nhắc nhập">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="E_auth" name="Có UID / ID sửa hợp lệ?" default="Flow_6" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="E_authfail" name="Báo lỗi; bật lại trạng thái Lưu">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_badend" name="Chưa lưu sự kiện">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="E_save" name="Thêm mới hoặc update title/icon/targetDate; chờ callback">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="E_result" name="Callback thành công?" default="Flow_10" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="E_error" name="Báo lỗi nếu Fragment còn gắn; cho sửa lại">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_errorend" name="Chưa xác nhận lưu">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="E_timestamp" name="Nhận ID; chỉ khi thêm: gửi update createdAt không chờ">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="E_attached" name="Fragment còn gắn?" default="Flow_14" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_detached" name="Đã ghi; callback dừng">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="E_request" name="Yêu cầu quyền thông báo nếu cần; không chờ trả lời">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="E_manager" name="AlarmManager khả dụng?" default="Flow_18" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="E_cancel" name="Hủy cả hai alarm cũ của event">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="E_times" name="Lần lượt lấy 08:00 ngày trước và 08:00 ngày diễn ra">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="E_future" name="Mốc đang xét &gt; hiện tại?" default="Flow_21" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="E_skip" name="Bỏ qua mốc đã qua">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="E_schedule" name="Đặt alarm cho mốc này: exact nếu cho phép; nếu không inexact">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="E_more" name="Còn mốc chưa xét?" default="Flow_26" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="E_success" name="Thông báo lưu thành công; đóng bottom sheet">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_end" name="Đã lưu; có thể có 0–2 alarm">
      <bpmn:incoming>Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="E_start" targetRef="E_input" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="E_input" targetRef="E_valid" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="E_valid" targetRef="E_hint" name="Chưa hợp lệ" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="E_hint" targetRef="E_input" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="E_valid" targetRef="E_auth" name="Hợp lệ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">targetDate &gt; 0 and trim(title) != ""</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="E_auth" targetRef="E_authfail" name="Không" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="E_authfail" targetRef="E_badend" name="" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="E_auth" targetRef="E_save" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">uid != null and (not edit or validId)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="E_save" targetRef="E_result" name="" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="E_result" targetRef="E_error" name="Lỗi" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="E_error" targetRef="E_errorend" name="" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="E_result" targetRef="E_timestamp" name="Thành công">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">callback.success</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="E_timestamp" targetRef="E_attached" name="" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="E_attached" targetRef="E_detached" name="Không" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="E_attached" targetRef="E_request" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fragment.isAdded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="E_request" targetRef="E_manager" name="" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="E_manager" targetRef="E_cancel" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">alarmManager != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="E_manager" targetRef="E_success" name="Không" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="E_cancel" targetRef="E_times" name="" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="E_times" targetRef="E_future" name="" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="E_future" targetRef="E_skip" name="Không" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="E_future" targetRef="E_schedule" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">triggerAt &gt; now</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="E_skip" targetRef="E_more" name="" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="E_schedule" targetRef="E_more" name="" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="E_more" targetRef="E_times" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasNextSlot</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="E_more" targetRef="E_success" name="Không" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="E_success" targetRef="E_end" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_bpmn-03-event-reminders">
    <bpmndi:BPMNPlane id="Plane_bpmn-03-event-reminders" bpmnElement="Collaboration_bpmn-03-event-reminders">
