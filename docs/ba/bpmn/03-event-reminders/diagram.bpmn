      <bpmndi:BPMNEdge id="DI_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="245.0" y="182.0" />
        <di:waypoint x="245.0" y="241.0" />
      </bpmndi:BPMNEdge>
