<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_bpmn-01-create-task" targetNamespace="https://ticktok.local/analysis/bpmn-01-create-task" exporter="TickTok BA diagrams" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_bpmn-01-create-task">
    <bpmn:participant id="Participant_bpmn-01-create-task" name="BPMN-01 · Tạo công việc và đặt lời nhắc" processRef="Process_bpmn-01-create-task" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn-01-create-task" name="BPMN-01 · Tạo công việc và đặt lời nhắc" isExecutable="false">
    <bpmn:documentation>Quy trình nghiệp vụ TickTok. Mô hình phân tích, không thực thi; thao tác SDK và callback được biểu diễn bằng service task.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_bpmn-01-create-task">
      <bpmn:lane id="Lane_bpmn-01-create-task_0" name="Tương tác người dùng / UI">
        <bpmn:flowNodeRef>T_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_hint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_clear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_noauth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_authend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn-01-create-task_1" name="Ứng dụng TickTok">
        <bpmn:flowNodeRef>T_empty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_badreminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_errorend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn-01-create-task_2" name="Firestore SDK / callback">
        <bpmn:flowNodeRef>T_add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn-01-create-task_3" name="Android: quyền và alarm">
        <bpmn:flowNodeRef>T_future</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_schedule</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="T_start" name="Bấm thêm công việc">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_input" name="Nhập nội dung, ngày, ưu tiên và lời nhắc; bấm Gửi">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="T_empty" name="Nội dung sau trim rỗng?" default="Flow_5" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_hint" name="Hiện gợi ý nhập nội dung; giữ form">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_prepare" name="Tách dòng đầu thành tiêu đề; ngày mặc định hôm nay">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="T_badreminder" name="Lời nhắc quá khứ / sau ngày hạn?" default="Flow_9" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_clear" name="Xóa reminderTime về 0; báo lý do; vẫn tạo task">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="T_merge" name="Tiếp tục xử lý" gatewayDirection="Converging">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="T_auth" name="Có UID?" default="Flow_11" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_noauth" name="Yêu cầu đăng nhập; không ghi task">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="T_authend" name="Dừng; form chưa lưu">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_add" name="Gọi add(task) vào users/UID/tasks; chờ kết quả">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="T_result" name="Callback thành công?" default="Flow_15" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_error" name="Báo lỗi ghi; giữ form để người dùng xử lý">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="T_errorend" name="Chưa xác nhận lưu">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_id" name="Nhận document ID; gửi update createdAt không chờ">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="T_future" name="reminderTime &gt; hiện tại?" default="Flow_19" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_cancel" name="Hủy alarm cũ nếu có">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_request" name="Nếu Android 13+ chưa cấp: yêu cầu quyền thông báo; không chờ">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_schedule" name="Thay alarm: exact nếu được phép; nếu không, dùng inexact">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="T_success" name="Thông báo thêm thành công; đóng bottom sheet">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="T_end" name="Task đã được ghi">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="T_start" targetRef="T_input" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T_input" targetRef="T_empty" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T_empty" targetRef="T_hint" name="Rỗng">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">trim(rawInput) == ""</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="T_hint" targetRef="T_input" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T_empty" targetRef="T_prepare" name="Có nội dung" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="T_prepare" targetRef="T_badreminder" name="" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="T_badreminder" targetRef="T_clear" name="Không hợp lệ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reminder &gt; 0 and (reminder &lt;= now or reminder &gt;= dueDate + 86400000)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T_clear" targetRef="T_merge" name="" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="T_badreminder" targetRef="T_merge" name="Hợp lệ / không đặt" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T_merge" targetRef="T_auth" name="" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="T_auth" targetRef="T_noauth" name="Không" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="T_noauth" targetRef="T_authend" name="" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="T_auth" targetRef="T_add" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">uid != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="T_add" targetRef="T_result" name="" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="T_result" targetRef="T_error" name="Lỗi" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="T_error" targetRef="T_errorend" name="" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T_result" targetRef="T_id" name="Thành công">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">callback.success</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="T_id" targetRef="T_future" name="" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="T_future" targetRef="T_cancel" name="Không" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="T_future" targetRef="T_request" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reminder &gt; now</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="T_request" targetRef="T_schedule" name="" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="T_cancel" targetRef="T_success" name="" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="T_schedule" targetRef="T_success" name="" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="T_success" targetRef="T_end" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_bpmn-01-create-task">
