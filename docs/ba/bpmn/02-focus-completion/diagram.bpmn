<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_bpmn-02-focus-completion" targetNamespace="https://ticktok.local/analysis/bpmn-02-focus-completion" exporter="TickTok BA diagrams" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_bpmn-02-focus-completion">
    <bpmn:participant id="Participant_bpmn-02-focus-completion" name="BPMN-02 · Kết thúc phiên FOCUS và ghi lịch sử" processRef="Process_bpmn-02-focus-completion" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn-02-focus-completion" name="BPMN-02 · Kết thúc phiên FOCUS và ghi lịch sử" isExecutable="false">
    <bpmn:documentation>Quy trình nghiệp vụ TickTok. Mô hình phân tích, không thực thi; thao tác SDK và callback được biểu diễn bằng service task.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_bpmn-02-focus-completion">
      <bpmn:lane id="Lane_bpmn-02-focus-completion_0" name="Điều khiển phiên">
        <bpmn:flowNodeRef>P_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_break</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_cycleend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_manualstop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_manualauth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_reset</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn-02-focus-completion_1" name="Chuẩn bị lịch sử / callback">
        <bpmn:flowNodeRef>P_autoprep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_autouid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_autoskip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_autofail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_manualprep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_manualuid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_manualfail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn-02-focus-completion_2" name="Firestore SDK">
        <bpmn:flowNodeRef>P_autowrite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_autowait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_autoresult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_autook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_saveend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_manualwrite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_manualresult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_manualok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P_start" name="FOCUS hết giờ hoặc bấm Complete">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="P_auto" name="Tự hết giờ?" default="Flow_16" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="P_fork" name="Hai nhánh không chờ nhau" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="P_break" name="Đổi sang BREAK 5 phút và tự khởi chạy">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P_cycleend" name="Chu kỳ tiếp tục">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="P_autoprep" name="duration = totalMillis; resetAfterSave = false">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P_autouid" name="Có UID?" default="Flow_7" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P_autoskip" name="Bỏ qua ghi lịch sử">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="P_autowrite" name="Gửi add lịch sử: totalMillis, tên task, thời điểm lưu; chưa chờ">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P_autowait" name="Đợi callback ghi lịch sử">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P_autoresult" name="Callback thành công?" default="Flow_13" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P_autook" name="Toast đã lưu nếu có Context">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P_autofail" name="Toast lỗi nếu có Context; không dừng chu kỳ">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P_saveend" name="Kết thúc nhánh lưu">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="P_manualstop" name="Complete: hủy timer, đặt isRunning/isPaused = false">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P_manualprep" name="duration = totalMillis; resetAfterSave = true">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P_manualuid" name="Có UID?" default="Flow_19" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P_manualauth" name="Báo cần đăng nhập nếu có Context">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="P_manualwrite" name="Gọi add lịch sử; chờ callback thành công hoặc thất bại">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P_manualresult" name="Callback thành công?" default="Flow_24" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P_manualok" name="Toast đã lưu nếu có Context">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P_manualfail" name="Toast lỗi nếu có Context">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P_reset" name="Reset về FOCUS đã chọn; không tự chạy">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P_end" name="Sẵn sàng phiên mới">
      <bpmn:incoming>Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="P_start" targetRef="P_auto" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="P_auto" targetRef="P_autoprep" name="Hết giờ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">trigger == timerFinish</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="P_fork" targetRef="P_break" name="" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="P_break" targetRef="P_cycleend" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="P_fork" targetRef="P_autowait" name="" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="P_autoprep" targetRef="P_autouid" name="" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="P_autouid" targetRef="P_autoskip" name="Không" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="P_autouid" targetRef="P_autowrite" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">uid != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="P_autoskip" targetRef="P_break" name="" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="P_autowrite" targetRef="P_fork" name="" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="P_autowait" targetRef="P_autoresult" name="" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="P_autoresult" targetRef="P_autook" name="Thành công">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">callback.success</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="P_autoresult" targetRef="P_autofail" name="Lỗi" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="P_autook" targetRef="P_saveend" name="" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="P_autofail" targetRef="P_saveend" name="" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="P_auto" targetRef="P_manualstop" name="Complete" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="P_manualstop" targetRef="P_manualprep" name="" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="P_manualprep" targetRef="P_manualuid" name="" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="P_manualuid" targetRef="P_manualauth" name="Không" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="P_manualauth" targetRef="P_reset" name="" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="P_manualuid" targetRef="P_manualwrite" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">uid != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="P_manualwrite" targetRef="P_manualresult" name="" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="P_manualresult" targetRef="P_manualok" name="Thành công">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">callback.success</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="P_manualresult" targetRef="P_manualfail" name="Lỗi" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="P_manualok" targetRef="P_reset" name="" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="P_manualfail" targetRef="P_reset" name="" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="P_reset" targetRef="P_end" name="" />
  </bpmn:process>
